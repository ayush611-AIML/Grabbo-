# Optional overrides for the EmailJS IDs used by the Queries & Collaboration form (https://dashboard.emailjs.com).
# The defaults are in src/main.js; set these in .env.local or in Vercel only to use a different EmailJS account.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
